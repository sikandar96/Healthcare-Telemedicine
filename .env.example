# MongoDB
MONGO_URI=mongodb://localhost:27017/Healthcare-Telemedicine

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Frontend CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP email OTP delivery
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-provider-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_OTP_EMAIL_FROM=your-email@example.com

# Optional SMS provider webhook
APP_OTP_SMS_WEBHOOK_URL=

# Local development only; never enable in production
APP_OTP_EXPOSE_IN_RESPONSE=false
